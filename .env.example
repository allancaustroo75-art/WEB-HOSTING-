# =============================================================================
# OPTIONAL - .env file is NO LONGER REQUIRED
# Primary configuration is now in backend/config.py
# This file is kept for reference and optional Railway/local overrides
# =============================================================================
# If you prefer using .env, values here will override backend/config.py via OS env
# But you can simply edit backend/config.py directly and delete this file

# --- Telegram ---
BOT_TOKEN=123456:your-bot-token-from-botfather
ADMIN_USER_IDS=111111111
OWNER_USER_ID=111111111

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# --- Storage / limits ---
DATABASE_PATH=./data/bothost.db
PROJECTS_DIR=./projects
MAX_PROJECTS_PER_USER=10
MAX_UPLOAD_BYTES=26214400
PROCESS_CPU_SECONDS=3600
PROCESS_MEMORY_MB=256

# --- Mini App & Dashboard ---
MINI_APP_URL=https://your-app.up.railway.app
DASHBOARD_BASE_URL=https://your-app.up.railway.app
LOGIN_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=43200

# --- Web server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
